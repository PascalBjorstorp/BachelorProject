<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mpc_fpga</name>
  <version>0.1.0</version>
  <description>Model Predictive Control for F1/10th Autonomous Vehicle</description>
  <maintainer email="jonathan@example.com">Jonathan</maintainer>
  <license>MIT</license>

  <!-- ROS2 Jazzy build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core ROS2 dependencies -->
  <depend>rclc</depend>
  <depend>rcl</depend>
  <depend>rcutils</depend>

  <!-- Message type dependencies -->
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>ackermann_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>

  <!-- Build dependencies -->
  <build_depend>rosidl_default_generators</build_depend>

  <!-- Exec dependencies -->
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>f1tenth_planning</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
