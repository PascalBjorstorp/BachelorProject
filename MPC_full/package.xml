<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mpc_full</name>
  <version>1.0.0</version>
  <description>
    MPC Riccati-ADMM controller for F1/10th.
  </description>
  <maintainer email="akmun23@student.sdu.dk">F1TENTH Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rcl</build_depend>
  <exec_depend>rcl</exec_depend>

  <build_depend>rclc</build_depend>
  <exec_depend>rclc</exec_depend>

  <build_depend>nav_msgs</build_depend>
  <exec_depend>nav_msgs</exec_depend>

  <build_depend>ackermann_msgs</build_depend>
  <exec_depend>ackermann_msgs</exec_depend>

  <build_depend>std_msgs</build_depend>
  <exec_depend>std_msgs</exec_depend>

  <build_depend>geometry_msgs</build_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <build_depend>rcutils</build_depend>
  <exec_depend>rcutils</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
