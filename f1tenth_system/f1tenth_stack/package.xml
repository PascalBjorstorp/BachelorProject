<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>f1tenth_stack</name>
  <version>1.0.0</version>
  <description>
    Onboard drivers for VESC and sensors for F1TENTH vehicles.
    Enhanced version with improved IMU handling, braking, and DS4 controller support.
  </description>
  <maintainer email="your-email@example.com">Your Name</maintainer>
  <license>MIT</license>

  <depend>ackermann_msgs</depend>
  <depend>rclpy</depend>
  <depend>urg_node</depend>
  <depend>joy</depend>
  <depend>joy_teleop</depend>
  <depend>vesc</depend>
  <depend>vesc_msgs</depend>
  <depend>ackermann_mux</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
