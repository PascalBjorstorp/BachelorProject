<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mpcc_f1_10th</name>
  <version>0.1.0</version>
  <description>Model Predictive Contouring Control for F1/10th Autonomous Racing</description>
  <maintainer email="jonathan@example.com">Jonathan</maintainer>
  <license>MIT</license>

  <!-- ROS2 build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core ROS2 dependencies -->
  <depend>rclc</depend>
  <depend>rcl</depend>
  <depend>rcutils</depend>

  <!-- Message type dependencies -->
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>ackermann_msgs</depend>
  <depend>std_msgs</depend>

  <!-- Build dependency on MPC package (shared sources: fp_math, vehicle_model) -->
  <build_depend>mpc_f1_10th</build_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
