# =============================================
# F1Tenth BachelorProject .gitignore
# =============================================
# This file ensures only source code is committed,
# not build artifacts or generated files.

# =============================================
# ROS2 / Colcon Build Artifacts
# =============================================
# Top-level build directories (from colcon build)
/build/
/install/
/log/

# Package-level build directories
**/build/
**/install/
**/log/

# =============================================
# Python
# =============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.eggs/
dist/
develop-eggs/
.installed.cfg

# Virtual environments
.venv/
venv/
ENV/
env/

# =============================================
# C++ Build Artifacts
# =============================================
# Compiled object files
*.o
*.obj

# Precompiled headers
*.gch
*.pch

# Compiled libraries
*.lib
*.a
*.la
*.lo

# Shared objects
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app

*worker*


# =============================================
# IDE / Editor
# =============================================
# VSCode
.vscode/
*.code-workspace

# JetBrains (CLion, PyCharm)
.idea/
*.iml

# Eclipse
.project
.cproject
.pydevproject
.settings/

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
auto-save-list
tramp

