# =============================================
# F1Tenth BachelorProject .gitignore
# =============================================
# This file ensures only source code is committed,
# not build artifacts or generated files.

# =============================================
# ROS2 / Colcon Build Artifacts
# =============================================
# Top-level build directories (from colcon build)
/build/
/install/
/log/

# Package-level build directories
**/build/
**/install/
**/log/

# =============================================
# Python
# =============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.eggs/
dist/
develop-eggs/
.installed.cfg

# Virtual environments
.venv/
venv/
ENV/
env/

# =============================================
# C++ Build Artifacts
# =============================================
# Compiled object files
*.o
*.obj

# Precompiled headers
*.gch
*.pch

# Compiled libraries
*.lib
*.a
*.la
*.lo

# Shared objects
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app


# =============================================
# IDE / Editor
# =============================================
# VSCode
.vscode/
*.code-workspace

# JetBrains (CLion, PyCharm)
.idea/
*.iml

# Eclipse
.project
.cproject
.pydevproject
.settings/

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
auto-save-list
tramp

# =============================================
# OS Generated
# =============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# =============================================
# ROS2 Specific
# =============================================
# Test results
test_results/
test-results/

# URDF compiled from xacro
*.urdf


# =============================================
# Documentation Build
# =============================================
docs/_build/
docs/api/

# =============================================
# ROS2 Bag Files (large binary recordings)
# =============================================
bags/
*.db3
*.mcap

# =============================================
# Compiled Test Binaries (no extension)
# =============================================
MPC/test_sim_drive*
MPC/mpc_test
MPC/test/test_mpc_cpu
FPGA_Implementations/**/tb_mpc
FPGA_Implementations/**/tb_test
FPGA_Implementations/**/tb_mpc_fpga_check
FPGA_Implementations/**/test_fpga_sim*

# =============================================
# Tuning / Benchmark Outputs
# =============================================
MPC/test/tuning_results_*.csv
MPC/test/full_sweep_output.txt
MPC/test/tune_weights_old.py
f1tenth_localization/Benchmark/localization_benchmark_*.csv

# =============================================
# Parameter Experiment Data (large CSVs)
# =============================================
f1tenth_parameters/data/*.csv
f1tenth_parameters/oldData/

# =============================================
# Trajectory Backup / Working Files
# =============================================
f1tenth_planning/trajectories/*_OLD*
f1tenth_planning/trajectories/*_backup*
f1tenth_planning/trajectories/*_working*
f1tenth_planning/trajectories/working_*.csv

# =============================================
# LaTeX Build Artifacts
# =============================================
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc

# =============================================
# FPGA Bitstream Artifacts
# =============================================
*.xsa
*.ltx

# =============================================
# Temporary / Misc
# =============================================
*.tmp
*.temp
*.bak
*.backup
*.log
*.pid
*.cmake

# Coverage reports
.coverage
htmlcov/

# =============================================
# FPGA / Vitis HLS
# =============================================
# HLS project directories (generated by vitis-run / vitis_hls)
*_hls/
*_cosim/
FPGA/build/
FPGA/logs/

# HLS output logs
FPGA/*.log

# =============================================
# Vivado Project Files
# =============================================
# Entire Vivado project (re-creatable from FPGA/create_vivado_project.tcl)
Ultra96_PP/

# Vivado journal and log files
*.jou
vivado*.log
vivado*.str

# Vivado temp/backup files
*.wdb
*.wcfg
.Xil/

# Vitis IDE workspace
_ide/

# =============================================
# FPGA Bitstream / Hardware Export
# =============================================
# Bitstream files (.bit, .bin) are tracked via Git LFS.
# Only ignore debug probes (.ltx) which are not needed.
FPGA/Bitstream/*.ltx
FPGA/docs/*
MPC/build_test/*
MPC/build_local/*
MPC/logs/*
FPGA_Implementations/MPC_experimental/build_test/*
FPGA_Implementations/MPC_experimental/build_local/*
FPGA_Implementations/MPC_experimental/logs/*
MPC_legacy/*
# =============================================
# Parameter csv files (excluded — large data)
# =============================================
f1tenth_parameters/data/*.csv

# CMake generated files
*CMakeConfigureLog.yaml
*CMakeCCompilerId.c
*.aux