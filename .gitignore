# =============================================
# F1Tenth BachelorProject .gitignore
# =============================================
# This file ensures only source code is committed,
# not build artifacts or generated files.

# =============================================
# ROS2 / Colcon Build Artifacts
# =============================================
# Top-level build directories (from colcon build)
/build/
/install/
/log/

# Package-level build directories
**/build/
**/install/
**/log/

# Colcon markers
COLCON_IGNORE
AMENT_IGNORE

# =============================================
# Python
# =============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.eggs/
dist/
develop-eggs/
.installed.cfg

# Virtual environments
.venv/
venv/
ENV/
env/

# =============================================
# C++ Build Artifacts
# =============================================
# Compiled object files
*.o
*.obj

# Precompiled headers
*.gch
*.pch

# Compiled libraries
*.lib
*.a
*.la
*.lo

# Shared objects
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app


# =============================================
# IDE / Editor
# =============================================
# VSCode
.vscode/
*.code-workspace

# JetBrains (CLion, PyCharm)
.idea/
*.iml

# Eclipse
.project
.cproject
.pydevproject
.settings/

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
auto-save-list
tramp

# =============================================
# OS Generated
# =============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# =============================================
# ROS2 Specific
# =============================================
# Test results
test_results/
test-results/

# URDF compiled from xacro
*.urdf


# =============================================
# Documentation Build
# =============================================
docs/_build/
docs/api/

# =============================================
# Temporary / Misc
# =============================================
*.tmp
*.temp
*.bak
*.backup
*.log
*.pid
core
core.*
*.cmake
*.bin

# Coverage reports
.coverage
htmlcov/

# =============================================
# FPGA / Vitis HLS
# =============================================
# HLS project directories (generated by vitis-run / vitis_hls)
*_hls/
*_cosim/
FPGA/build/
FPGA/logs/

# HLS output logs
FPGA/*.log

# =============================================
# Vivado Project Files
# =============================================
# Entire Vivado project (re-creatable from FPGA/create_vivado_project.tcl)
Ultra96_PP/

# Vivado journal and log files
*.jou
vivado*.log
vivado*.str

# Vivado temp/backup files
*.wdb
*.wcfg
.Xil/

# Vitis IDE workspace
_ide/

# =============================================
# FPGA Bitstream / Hardware Export
# =============================================
# Keep the exported XSA for deployment
# (FPGA/Bitstream/ is tracked)
FPGA/Bitstream/*.bit
FPGA/Bitstream/*.bin
FPGA/Bitstream/*.ltx
FPGA/docs/*

# =============================================
# Parameter csv files 
# =============================================
f1tenth_parameters/data/*.csv

# CMake generated files
*CMakeConfigureLog.yaml
*CMakeCCompilerId.c
